{
  "name": "lifeplanos",
  "version": "0.1.0",
  "private": true,
  "description": "LifePlanOS \u2014 the operating system for life care planning. Standalone multi-tenant SaaS.",
  "scripts": {
    "dev": "next dev -p 3100",
    "dev:auto": "next dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "citations:refresh": "tsx scripts/refresh-citations.ts",
    "rollout:check": "tsx scripts/rollout-backfill.ts",
    "rollout:apply": "tsx scripts/rollout-backfill.ts --apply",
    "records:rebuild": "tsx scripts/rebuild-records.ts",
    "records:corroborate": "tsx scripts/corroborate-records.ts",
    "records:reextract": "tsx scripts/reextract-case.ts",
    "records:reaudit": "tsx scripts/reaudit-case.ts",
    "records:burden": "tsx scripts/review-burden.ts",
    "reasoning:backfill": "tsx scripts/backfill-reasoning.ts",
    "ocr:redo": "tsx scripts/ocr-redo.ts",
    "retention:enforce": "tsx scripts/enforce-retention.ts",
    "setup": "prisma migrate deploy && tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1085.0",
    "@aws-sdk/client-textract": "^3.1095.0",
    "@napi-rs/canvas": "^1.0.2",
    "@prisma/client": "^5.20.0",
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "lucide-react": "^1.23.0",
    "mammoth": "^1.12.0",
    "next": "^15.5.22",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^6.1.200",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.9.2",
    "stripe": "^22.3.1",
    "tailwind-merge": "^3.6.0",
    "tesseract.js": "^7.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.22",
    "postcss": "^8.5.25",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.7",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "0.35.3"
  }
}
