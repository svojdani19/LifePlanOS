# ── Database (required) ──────────────────────────────────────────────────────
# LifePlanOS runs on its OWN dedicated database (not a shared schema). Pooled
# connection for the app; unpooled DIRECT_URL for migrations/DDL.
#
# Fully self-hosted (recommended for local/dev): `docker compose up -d`, then:
#   DATABASE_URL="postgresql://lifeplanos:lifeplanos@localhost:5432/lifeplanos?sslmode=disable"
#   DIRECT_URL="postgresql://lifeplanos:lifeplanos@localhost:5432/lifeplanos?sslmode=disable"
#
# Managed (e.g. Neon) — point at a dedicated database, not a shared one:
DATABASE_URL="postgresql://USER:PASSWORD@HOST/lifeplanos?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/lifeplanos?sslmode=require"

# ── App ──────────────────────────────────────────────────────────────────────
APP_URL="http://localhost:3100"        # used for Stripe redirect URLs
NODE_ENV="development"

# ── Auth / security (optional; sensible defaults) ────────────────────────────
SESSION_IDLE_MINUTES="30"              # idle timeout before a session is invalidated
LOGIN_MAX_FAILURES="10"                # failed logins per IP per 15 min before 429

# ── Synthetic local demo data (optional; never use real credentials) ─────────
DEV_SEED_PASSWORD="LifePlanOS-Local-2026!" # npm run db:seed; seed refuses in production
ENABLE_DEMO_MODE="false"                   # true exposes /demo outside production
DEMO_PASSWORD="LifePlanOS-Demo-2026!"      # guarded 13-persona demo seed
# DEMO_MODE_PRODUCTION_ACK="false"         # required with ENABLE_DEMO_MODE in production

# ── Object storage (optional — falls back to local ./uploads if unset) ───────
# Set these in production to store PHI files encrypted in S3.
S3_BUCKET=""
S3_PREFIX=""                           # optional key namespace, e.g. "prod/"
S3_KMS_KEY_ID=""                       # set for SSE-KMS; otherwise SSE-S3 (AES256)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# ── Literature (optional) ────────────────────────────────────────────────────
# Future-care citations are sourced & ranked across multiple literature APIs.
# Europe PMC and Crossref need no key and are always used. Setting a Semantic
# Scholar key adds it as a reliable third source (its keyless tier is too rate-
# limited to depend on). A mailto puts Crossref requests in the faster pool.
CROSSREF_MAILTO=""                     # e.g. "you@example.com" (polite pool)
SEMANTIC_SCHOLAR_API_KEY=""            # optional third source

# ── AI model provider (optional — deterministic mock is used when unset) ─────
# Anthropic is HIPAA-eligible under a BAA. Set both to activate a real model.
LLM_PROVIDER=""                        # "anthropic" | "openai" | unset (mock)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"

# ── Billing (optional — mock billing is used when unset) ─────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_SOLO=""
STRIPE_PRICE_SMALL_FIRM=""
STRIPE_PRICE_ENTERPRISE=""

# ── OCR (optional — local Tesseract is used when unset) ──────────────────────
# Cloud OCR sends PHI to the vendor and requires ALL of: provider, a signed-BAA
# acknowledgement, and credentials. The Textract adapter is implemented; the
# AWS credentials above are reused. Misconfiguration fails loudly; no PHI sent.
OCR_PROVIDER=""                        # "textract" | "documentai" | "azure" | unset (local)
OCR_BAA_ACK=""                         # "true" ONLY once a BAA is signed with the vendor
OCR_DPI="300"                          # local render DPI (150–400)
OCR_PREP="none"                        # "none" | "enhance" | "binarize"

# ── Pricing (optional — labeled static reference figures when unset) ─────────
# Live venue-specific pricing is a LICENSED feed. With all three set, coded
# services are priced at the 80th percentile for the case geozip and each line
# item stores its retrieval date + provider snapshot.
PRICING_PROVIDER=""                    # "fairhealth" | "goodrx" | "genworth" | unset (static)
FAIRHEALTH_API_URL=""                  # licensed tenant benchmark endpoint
FAIRHEALTH_API_KEY=""

# ── PDF export (optional — ATD-7) ────────────────────────────────────────────
# PDF = the canonical DOCX converted through headless LibreOffice on this host.
PDF_CONVERTER="soffice"                # LibreOffice binary (path or name)
