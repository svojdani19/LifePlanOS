  effectiveUntil   DateTime?
  status           String    @default("ACTIVE") // ACTIVE | SCHEDULED | REVOKED | EXPIRED
  assignedById     String
  assignmentReason String?
  createdAt        DateTime  @default(now())
  revokedAt        DateTime?
  revokedById      String?
