// ── MDIP (docs/28): damages evaluation, engagements, notifications ───────────

model FutureDamagesEvaluation {
  id                            String   @id @default(uuid())
  firmId                        String
  caseId                        String
  caseRevision                  Int?
  logicVersion                  String
  evaluatedAt                   DateTime @default(now())
  evaluatedById                 String
  overallOutcome                String
  recommendedPrimaryProduct     String?
  recommendedAdditionalProducts Json
  readinessState                String
  supportingFactors             Json
