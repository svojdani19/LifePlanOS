// ── Source-grounded record extraction (LLM-assisted, human-verified) ─────────
// One row per extraction RUN over one document: which model/prompt/schema
// produced it, over which exact source bytes (fingerprint), and how it ended.
// Failed or unreliable runs are recorded — never silently replaced by
// template prose. PHI-bearing prompts/responses are NEVER stored here.
/// A finding about the RECORD, scoped to the thing it is actually about.
///
/// Replaces the unstructured `ExtractedEncounter.auditFindings` array as the
/// source of truth for review presentation and metrics. That array stored the
/// whole document's findings on every row, so one document-level problem
/// appeared on hundreds of entries and a metric counting its text reported a
/// handful of real issues as hundreds. A finding here names its own target and
/// is counted by identity.
///
/// Additive: legacy auditFindings is retained for compatibility and is no
/// longer authoritative.
/// One piece of evidence, tied to ONE recommendation and ONE claim about it.
///
/// Evidence used to be selected per DIAGNOSIS — `eventPertains()` matched a
/// chronology event by body region or by any word of the diagnosis name — so
/// five services for one lumbar diagnosis drew the same pool, and findings
/// that established the condition were displayed as though they established
/// the necessity of each intervention.
///
/// Two kinds of row live here and they are governed differently:
///
///   MACHINE rows are derived. They are rebuilt from scratch on every plan
///   generation, because they are a function of the records and the rules.
///
///   PHYSICIAN rows are a clinician's own citation, entered by hand. They
///   survive regeneration untouched — a person's contribution is never
///   discarded by a machine pass, which is the same rule the record findings
///   and the chronology already live by.
model RecommendationEvidence {
  id     String @id @default(uuid())
  firmId String
  caseId String

  /// The recommendation this evidence was selected FOR — the SPECIFIC version.
  futureCareItemId String
  /// The recommendation's LINEAGE, which survives regeneration when its item
  /// id does not. 22 of 59 items on the reference case are deleted and
  /// recreated with fresh ids on every plan generation, so a physician
  /// citation keyed only to futureCareItemId was preserved by the writer and
  /// then pointed at a dead row — invisible in the panel, unreachable by the
  /// delete route. Kept alive by lineage, and by the service name when no
  /// lineage carried over.
  lineageId        String?
  /// Normalised service name: the last resort for re-linking after a rebuild.
  serviceKey       String?
  /// The condition the item was resolved against when this row was built.
  conditionId      String?

  /// NECESSITY | FREQUENCY | DURATION | FUNCTIONAL_NEED | PRIOR_TREATMENT | COST
  claim    String
  /// SUPPORTS | OPPOSES | CONTEXT — opposition is not the same as absence.
  stance   String
  /// DIAGNOSIS | OBJECTIVE | HISTORY | REPORTED | GUIDELINE | LITERATURE
  strength String

  // ── Where it came from ───────────────────────────────────────────────────
  /// RECORD_CLAIM | CHRONOLOGY_EVENT | GUIDELINE | LITERATURE | INTERVIEW | PHYSICIAN
  sourceKind        String
  sourceDocumentId  String?
  encounterId       String?
  chronologyEventId String?
  page              Int?
  /// The extraction field the quote came from, when it came from one.
  field             String?
  /// The supporting text. `verbatim` says whether it is the record's own
  /// words or the extraction's prose about the encounter — both are cited,
  /// and only the first may be presented as what the chart says.
  quote             String
  verbatim          Boolean   @default(false)
  /// The date the underlying record carries, for pre/post-incident reasoning.
  recordedOn        DateTime?

  // ── A physician-entered citation ─────────────────────────────────────────
  citationTitle   String?
  citationJournal String?
  citationYear    String?
  citationDoi     String?
  citationPmid    String?
  citationUrl     String?

  /// Source bytes this row was derived from — a change makes it stale.
  sourceFingerprint String?
  /// Builder version, so a rebuilt ledger is distinguishable from an old one.
  producerVersion   String?

  /// Set when a person supplied this row. Its presence is what protects it
  /// from being deleted by the next generation.
  addedById         String?
  addedAt           DateTime?
  /// The contributor's role at the moment of contribution, and their stated
  /// credential. A bare user id cannot tell a later reader whether this was a
  /// physician's selection or a planner's, which is exactly what a section
  /// headed "Physician-selected evidence" asserts.
  addedByRole       String?
  addedByCredential String?

  createdAt DateTime @default(now())

  @@index([caseId, futureCareItemId])
  @@index([futureCareItemId, claim])
  @@index([caseId, addedById])
  @@index([caseId, lineageId])
}

model RecordFinding {
  id     String @id @default(uuid())
  // Tenancy carried as scalars, matching SourcePage: these audit tables are
  // written by pipeline code that already holds the ids, and adding relations
  // would put back-references on Firm and Case for no query benefit.
  firmId String
  caseId String

  /// CASE | DOCUMENT | PAGE | NOTE | ENTRY | CLAIM
  scope    String
  type     String
  severity String  @default("WARNING") // INFO | WARNING | BLOCKING
  blocking Boolean @default(false)
  /// DETERMINISTIC_VALIDATOR | EXTRACTION_CRITIC | ADJUDICATOR | CORROBORATION | OCR | PAGE_LEDGER | HUMAN_REVIEW
  source   String

  // ── Target: only the fields the scope actually names are populated ────────
  sourceDocumentId String?
  pageStart        Int?
  pageEnd          Int?
  /// Stable identity of the canonical note (document id + its sorted row ids).
  canonicalNoteId  String?
  encounterId      String?
  /// Index of the claim within its encounter, when the finding is about one.
  claimIndex       Int?
  /// Field the finding concerns (date, provider, laterality…), when applicable.
  field            String?

  /// PHI-safe explanation for a reviewer.
  detail  String
  /// Verbatim supporting source text, when quoting the source is the evidence.
  excerpt String?

  // ── Provenance ───────────────────────────────────────────────────────────
  sourceFingerprint String?
  promptVersion     String?
  model             String?
  /// Comparator/adjudicator/audit version that produced this finding.
  producerVersion   String?

  /// Stable dedup key: the same problem re-derived must not become a new row.
  fingerprint String

  status                       String    @default("OPEN") // OPEN | CONFIRMED | DISMISSED | RESOLVED
  dispositionReason            String?
  reviewedById                 String?
  reviewedAt                   DateTime?
  /// The source fingerprint the reviewer was looking at when they dispositioned
  /// this finding. A dismissal covers the content it was given over — when the
  /// source changes underneath it, the disposition no longer applies and the
  /// finding reopens rather than silently carrying forward.
  dispositionSourceFingerprint String?
  /// PHI-free lineage of prior dispositions: [{ status, reason, byId, at,
  /// sourceFingerprint }]. A superseded or reopened disposition is retained
  /// here — a human decision is never deleted, only moved into history.
  dispositionHistory           Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([caseId, fingerprint])
  @@index([caseId, status])
  @@index([caseId, scope, status])
  @@index([sourceDocumentId, status])
  @@index([encounterId])
  @@index([canonicalNoteId])
}

model RecordExtraction {
  id                String   @id @default(uuid())
  firmId            String
  caseId            String
  sourceDocumentId  String
  // PENDING | RUNNING | PAUSED | COMPLETE | EXTRACTION_FAILED | BLOCKED_OCR | ABANDONED
  status            String   @default("PENDING")
  provider          String? // llm provider name
  model             String? // resolved model identifier
  promptVersion     String?
  schemaVersion     String?
  sourceFingerprint String? // sha256 of the exact extracted text processed
  truncated         Boolean  @default(false) // source exceeded processing bounds; disclosed
  chunkCount        Int      @default(0)
  candidateCount    Int      @default(0) // claims proposed by the model
  acceptedCount     Int      @default(0) // claims that survived deterministic validation
  rejectedCount     Int      @default(0)
  warnings          Json? // string[] — OCR confidence, truncation, rejects (no PHI)
  error             String? // actionable failure reason (no PHI)
  // Multi-pass provenance: what the critic and adjudicator contributed.
  criticFindings    Json? // string[] — PHI-safe critic observations
  // Dated note headers the deterministic segmenter found with no extracted
  // encounter: under-extraction of THIS document. Recorded so the case-level
  // completion gate can see it without every row of the document having to
  // carry it as its own defect.
  coverageGaps      Int      @default(0)
  // Sections/chunks of this document that could not be processed after
  // retries. Persisted because a deterministic re-audit must be able to SEE
  // this blocker; while it was only ever a local variable, a re-audit read
  // zero and could resolve a section-not-processed finding it never evaluated.
  failedSections    Int      @default(0)
  disputedCount     Int      @default(0) // claims the critic contested
  adjudicatedCount  Int      @default(0) // disputes an adjudicator resolved
  pagesTotal        Int      @default(0)
  pagesReadable     Int      @default(0)
  auditResult       String? // document-level audit outcome
  createdById       String?
  createdAt         DateTime @default(now())

  // ── Run lifecycle ─────────────────────────────────────────────────────────
  // A run row is created when work STARTS, so an interrupted run is visible as
  // an unfinished run rather than as no run at all.
  startedAt   DateTime?
  finishedAt  DateTime?
  // Liveness for the run lock: a RUNNING row whose heartbeat has gone cold is
  // a crashed run and may be taken over, so a crash cannot block a document
  // forever.
  heartbeatAt DateTime?
  durationMs  Int?
  chunksTotal Int       @default(0)
  chunksDone  Int       @default(0)
  // PHI-free resume cursor: { nextChunkIndex } — chunk positions only, never
  // record content.
  resumeState Json?
  // PHI-free counters (model calls, retries, timings) for operations.
  telemetry   Json?
  // Run lock: "ACTIVE" while a run holds this document, NULL once it reaches a
  // terminal state. Postgres treats NULLs as distinct, so the unique index
  // permits unlimited finished runs but only ONE unfinished run per document.
  lockKey     String?

  @@unique([sourceDocumentId, lockKey])
  @@index([caseId, sourceDocumentId])
  @@index([firmId])
  @@index([status, heartbeatAt])
}

// One VALIDATED encounter extracted from one document. Claim-level provenance
// lives in `claims` (field, value, exact supporting excerpt, page, confidence,
// warning). Human review is lineage-based: corrections and verifications are
// never overwritten by a regeneration — a new run supersedes AI drafts only,
// and marks reviewed rows STALE when the source bytes changed.
model ExtractedEncounter {
  id                  String    @id @default(uuid())
  extractionId        String
  firmId              String
  caseId              String
  sourceDocumentId    String
  page                Int? // NULL = unknown page (never coerced to 1)
  pageEnd             Int?
  dateStatus          String    @default("UNKNOWN") // DOCUMENTED | INFERRED | UNKNOWN | DISPUTED
  encounterDate       DateTime?
  encounterDateEnd    DateTime?
  // Verbatim date text as it appeared in the record, for reviewer comparison.
  dateSourceText      String?
  // CLINICAL | ANCILLARY | ADMINISTRATIVE — deterministic substance class
  // computed from the validated claims; only CLINICAL enters the chronology.
  // substanceReason is the reviewable explanation for any exclusion.
  substanceClass      String?
  substanceReason     String?
  // The TREATING clinician only. A deponent, a filing party, a payer, or a
  // records custodian is not a provider and must never be recorded as one.
  provider            String?
  providerCredentials String?

  // ── Document-kind provenance ──────────────────────────────────────────────
  // What KIND of document this row came from, and how that was decided. A
  // consolidated packet holds many kinds behind one filename, so this is
  // resolved per SEGMENT, not per upload.
  // CLINICAL_ENCOUNTER | THERAPY_COURSE | OPERATIVE | ANESTHESIA |
  // PATHOLOGY_DIAGNOSTIC | DEVICE_OR_IMPLANT | DIAGNOSTIC_STUDY | TESTIMONY |
  // EXPERT_OPINION | INCIDENT | FINANCIAL | EMPLOYMENT_ECONOMIC |
  // INSURANCE_ADMINISTRATIVE | LEGAL | CORRESPONDENCE_OR_GENERIC_EVIDENCE |
  // UNKNOWN. Null on rows written before this existed — read as UNKNOWN.
  analysisClass            String?
  /// Stable identity of the sub-document within a consolidated packet.
  segmentKey               String?
  /// DOCUMENT_TYPE | SEGMENT_CONTENT | FALLBACK_UNKNOWN
  classificationMethod     String?
  /// Content-classifier score when the class was derived from content.
  classificationConfidence Float?

  // Generalized authorship for documents that HAVE an author but not a
  // treating clinician: deponent, surgeon, interpreting physician, expert,
  // reporting officer, filing party. Kept separate from `provider` so nothing
  // downstream can mistake one for the other.
  attributionName     String?
  /// treating provider | deponent | surgeon | radiologist | expert | officer …
  attributionRole     String?
  facility            String?
  encounterType       String?
  // Deterministically rendered factual summary (from validated claims only).
  factualSummary      String
  // Optional LLM synthesis over the validated claims — clearly labeled in UI.
  synthesis           String?
  claims              Json // [{field, value, excerpt, page, confidence, warning?}]
  ocrConfidence       Float?
  warnings            Json? // string[]
  status              String    @default("AI_DRAFT") // AI_DRAFT | AI_AUDIT_PASSED | HUMAN_EDITED | REVIEWED | VERIFIED | STALE | SUPERSEDED | EXTRACTION_FAILED
  // Adversarial audit outcome for this encounter's draft:
  // PASS | NEEDS_HUMAN_REVIEW | EXTRACTION_INCOMPLETE | SOURCE_CONFLICT | FAILED
  auditResult         String?
  auditFindings       Json? // string[] — LEGACY, retained for compatibility only.
  // Scoped findings in RecordFinding are authoritative for review and metrics;
  // this array copied the whole document's findings onto every row.
  auditedAt           DateTime?
  /// Deterministic audit version that produced auditResult, so a re-audit can
  /// find rows graded by rules that have since been corrected.
  auditVersion        String?
  /// Disputes about THIS entry that no adjudicator could settle. Persisted so
  /// a deterministic re-audit reproduces the same verdict: without it a
  /// re-audit cannot see the conflict and would silently clear it.
  unresolvedDisputes  Int       @default(0)
  /// Entry fields adjudication confirmed the source contradicts (date,
  /// provider). Persisted for the same reason; never auto-corrected.
  contradictedFields  Json?
  // Machine corroboration: an INDEPENDENT blind re-read of the row's source
  // span reproduced (or failed to reproduce) its facts. A quality tier, never
  // a verification — corroboration cannot set VERIFIED or satisfy the human
  // gate. { result: CORROBORATED|NOT_CORROBORATED, at, model, promptVersion,
  //   reproduced, total, unreproducedFields: string[] }
  corroboration       Json?
  // Sentence -> supporting claim ids for the synthesized summary.
  sentenceClaimMap    Json?
  // Content hash of the claim set + summary a human verified, so a final
  // export can prove it is exporting exactly what was verified.
  verifiedContentHash String?
  editedFields        Json? // string[] of human-corrected fields
  reviewNote          String?
  reviewedById        String?
  reviewedAt          DateTime?
  verifiedById        String?
  verifiedAt          DateTime?
  supersededById      String?
  staleReason         String?
  sourceFingerprint   String? // fingerprint of the source at generation time
  promptVersion       String?
  schemaVersion       String?
  model               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([caseId, sourceDocumentId])
  @@index([caseId, status])
  @@index([caseId, analysisClass])
  @@index([firmId])
}

// One row per SOURCE PAGE. Page identity is server-owned: the model never
// assigns a page number, filename, document, case or firm — those are bound
// here from the document being processed and copied onto every claim that
// cites the page. Page-quality state (blank, unreadable, low-confidence,
// truncated) is decided BEFORE extraction, so a document with unreadable
// pages is disclosed as incomplete instead of yielding a confident chronology
// built on the pages that happened to read.
model SourcePage {
  id               String   @id @default(uuid())
  firmId           String
  caseId           String
  sourceDocumentId String
  filename         String
  pageNumber       Int
  text             String   @default("")
  offsetStart      Int      @default(0)
  offsetEnd        Int      @default(0)
  // NATIVE_TEXT | OCR | NONE — how this page's text was obtained. A native
  // text layer is not assigned an invented OCR confidence.
  ocrMethod        String   @default("NONE")
  ocrConfidence    Float? // null when not OCR'd — never a fabricated 0.96
  contentHash      String
  // READABLE | BLANK | LOW_CONFIDENCE | UNREADABLE | FAILED | DUPLICATE | PENDING_OCR | OCR_FAILED
  status           String   @default("READABLE")
  truncated        Boolean  @default(false)
  note             String? // PHI-safe reason for a non-READABLE status
  createdAt        DateTime @default(now())

  @@unique([sourceDocumentId, pageNumber])
  @@index([caseId, sourceDocumentId])
  @@index([firmId])
  @@index([caseId, status])
}

// Firm-scoped correction learning: a verified human correction of AI-extracted
// content, stored as structured field-level differences plus a fact-free
// guidance category. Exemplars teach formatting and extraction choices for
// FUTURE drafts in the SAME firm — they never carry patient names, dates,
// providers, or case facts into another case's prompt.
model CorrectionExemplar {
  id                String   @id @default(uuid())
  firmId            String
  caseId            String
  encounterId       String
  documentType      String? // taxonomy type of the source document
  category          String // WRONG_FIELD | BOILERPLATE_REMOVED | DATE_CORRECTED | PROVIDER_CORRECTED | EXCERPT_MISMATCH | SUMMARY_REWORDED | OTHER
  guidance          String // fact-free, deterministic guidance sentence for prompts
  fieldDiffs        Json // [{field, changeType}] — no values copied across cases
  draftSnapshot     Json // original AI draft (stays in the owning firm/case only)
  correctedSnapshot Json
  claimRefs         Json? // claim identifiers within the encounter
  reviewerId        String
  promptVersion     String?
  schemaVersion     String?
  model             String?
  promoted          Boolean  @default(false) // measured as improving accuracy
  verifiedAt        DateTime @default(now())

  @@index([firmId, documentType])
  @@index([caseId])
}

// ── Controlled learning loop ─────────────────────────────────────────────────
// The program already learns in two narrow ways — correction exemplars feed
// fact-free guidance into extraction prompts, and learned priors nudge
// future-care drafts from a firm's own physician corrections. Neither records
// WHAT WENT WRONG, so nothing can measure a repeat failure, tell a recoverable
// miss from an unrecoverable one, or decide which mechanism should learn from a
// given defect. These two models carry the lifecycle those mechanisms lack.
//
// PHI stays out. A finding references the protected rows it concerns by ID and
// records structural deltas (which fields changed, which claim ids were added
// or removed) — never record text, patient identifiers, or model responses.

/// One thing the program got wrong, from allegation through to adopted lesson.
model LearningFinding {
  id     String  @id @default(uuid())
  firmId String // learning is firm-scoped; findings never cross tenants
  caseId String?

  // Affected objects, by ID only.
  documentId        String?
  encounterId       String?
  chronologyEventId String?
  futureCareItemId  String?

  /// EXTRACTION | IDENTITY | SUMMARY | CHRONOLOGY | CARE_PLAN | PRICING
  stage           String
  /// Closed vocabulary — see lib/learning/failureTaxonomy.ts
  failureCode     String
  /// SAFETY_CRITICAL | MATERIAL | QUALITY
  severity        String
  /// CRITIC | FACTUAL_AUDIT | SECTION_LEDGER | DETERMINISTIC_CHECK | HUMAN_REVIEW
  detectionSource String

  // A critic's allegation is not training truth: it becomes learnable only
  // after deterministic confirmation or an authorized human correction.
  /// DETERMINISTIC | HUMAN_REVIEWER | HUMAN_CLINICAL
  validatorKind   String?
  /// CONFIRMED | REJECTED
  validatorResult String?
  /// DETECTED | VALIDATED | REJECTED_FALSE_POSITIVE | REPAIRED | UNRESOLVED |
  /// LEARNING_CANDIDATE | EVALUATED | ADOPTED | REJECTED_NO_IMPROVEMENT | RETIRED
  state           String  @default("DETECTED")

  // Everything needed to reproduce the run that produced the defect.
  modelVersion      String?
  promptVersion     String?
  schemaVersion     String?
  criticVersion     String?
  writerVersion     String?
  engineVersion     String?
  sourceFingerprint String?

  // Structural provenance. Claim IDENTIFIERS only — never claim text.
  originalClaimIds Json?
  addedClaimIds    Json?
  removedClaimIds  Json?
  selectedClaimIds Json?
  rejectedClaimIds Json?
  /// [{field, changeType}] — what changed, never the values that changed
  correctionDelta  Json?
  /// True when a summary correction altered meaning rather than phrasing.
  changedMeaning   Boolean?

  reviewerId       String?
  reviewerRole     String?
  correctionReason String?

  /// CASE_ONLY | DOCUMENT_CLASS | FIRM_CLINICAL
  reusableScope String?
  documentClass String?
  sectionType   String?

  // Bounded repair: a targeted retry, not an unbounded loop.
  repairAttempts Int       @default(0)
  repairedAt     DateTime?

  candidateId String?
  candidate   LearningCandidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([firmId, state])
  @@index([firmId, failureCode, createdAt])
  @@index([caseId])
  @@index([candidateId])
}

/// A proposed change to how the program behaves, and the record of whether it
/// earned its place. Nothing is adopted because it improved the case that
/// produced it: adoption requires held-out evaluation, and a prior version
/// always remains available for rollback.
model LearningCandidate {
  id     String @id @default(uuid())
  firmId String

  /// DETERMINISTIC_RULE | TASK_GUIDANCE | SALIENCE_PREFERENCE | CLINICAL_PRIOR
  mechanism   String
  failureCode String
  /// Fact-free, deidentified. Never record text or patient facts.
  guidance    String
  /// Structural payload: which field, which document class, which claim type.
  payload     Json?

  documentClass String?
  sectionType   String?
  /// CASE_ONLY | DOCUMENT_CLASS | FIRM_CLINICAL
  scope         String

  /// How many independent validated findings support it. One correction is
  /// never enough to change firm-scoped clinical behaviour.
  supportCount Int @default(1)

  version Int    @default(1)
  /// DRAFT | EVALUATED | ADOPTED | REJECTED_NO_IMPROVEMENT | RETIRED
  status  String @default("DRAFT")

  /// Held-out scorecard: metric deltas, cases evaluated, safety-critical checks.
  evaluation  Json?
  /// True only when no safety-critical metric regressed.
  safetyClean Boolean?

  adoptedAt    DateTime?
  retiredAt    DateTime?
  /// The candidate this one supersedes, so rollback has a lineage to follow.
  supersedesId String?

  /// How many generated outputs recorded applying this candidate.
  applicationCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  findings LearningFinding[]

  @@index([firmId, status])
  @@index([firmId, mechanism, documentClass])
  @@index([supersedesId])
}

// One row per LLM-adjudicated duplicate pair — why two records became one, or
// did not. Append-only: a decision later reversed gets its humanOutcome set,
// never a rewrite. Content is identified by hash; the claims live on the rows
// the ids reference, so no clinical text is duplicated here.
model DuplicateAdjudication {
  id              String    @id @default(cuid())
  firmId          String
  caseId          String
  aRowIds         Json // string[]
  bRowIds         Json // string[]
  aDocumentId     String
  bDocumentId     String
  aContentHash    String
  bContentHash    String
  encounterDate   DateTime?
  aProvider       String?
  bProvider       String?
  attribution     String // SAME_CLINICIAN | BOTH_UNATTRIBUTED | ONE_ATTRIBUTED
  candidacyReason String
  decision        String // MERGED | KEPT_SEPARATE
  confidence      String
  explanation     String
  llmProvider     String?
  llmModel        String?
  promptVersion   String
  schemaVersion   String
  merged          Boolean
  // Set when a reviewer later confirms or reverses the machine's decision.
  humanOutcome    String? // CONFIRMED | REVERSED
  decidedAt       DateTime
  createdAt       DateTime  @default(now())

  @@index([firmId, caseId])
  @@index([caseId, decidedAt])
}
