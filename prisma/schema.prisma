model AccessGrant {
  id             String    @id @default(uuid())
  firmId         String
  userId         String
  scopeType      String // ORGANIZATION | OFFICE | CASE | REPORT
  scopeId        String?
  permissions    Json // permissionKey[]
  effectiveFrom  DateTime  @default(now())
  effectiveUntil DateTime // temporary access ALWAYS expires
  grantedById    String
  reason         String
  status         String    @default("ACTIVE") // ACTIVE | REVOKED | EXPIRED
